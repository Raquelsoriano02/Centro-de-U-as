@page "/tecnicas"
@inject ApiService Api

<PageTitle>Técnicas</PageTitle>

<h1 class="mb-3">Técnicas</h1>

<Alerta @bind-Mensaje="error" />
<Alerta @bind-Mensaje="exito" Tipo="success" />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@(tecnica.Id == 0 ? "Nueva técnica" : "Editar técnica")</h5>
                <EditForm Model="tecnica" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <CamposPersona Persona="tecnica" />
                    <div class="mb-2">
                        <label class="form-label">Especialidad</label>
                        <InputText class="form-control" @bind-Value="tecnica.Especialidad" />
                        <ValidationMessage For="() => tecnica.Especialidad" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" id="activa" @bind-Value="tecnica.Activa" />
                        <label class="form-check-label" for="activa">Activa</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    @if (tecnica.Id != 0)
                    {
                        <button type="button" class="btn btn-secondary ms-2" @onclick="Limpiar">Cancelar</button>
                    }
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (tecnicas == null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (tecnicas.Count == 0)
        {
            <p>No hay técnicas registradas.</p>
        }
        else
        {
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Especialidad</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in tecnicas)
                    {
                        <tr>
                            <td>@item.ObtenerNombreCompleto()</td>
                            <td>@item.Especialidad</td>
                            <td>@item.Telefono</td>
                            <td>
                                <span class="badge @(item.Activa ? "text-bg-success" : "text-bg-secondary")">@(item.Activa ? "Activa" : "Inactiva")</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarAsync(item.Id)">Editar</button>
                                <BotonEliminar OnConfirmar="() => EliminarAsync(item.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private const string Ruta = "api/Tecnica";

    private List<TecnicaDto>? tecnicas;
    private TecnicaDto tecnica = new();
    private string? error;
    private string? exito;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var result = await Api.GetAsync<List<TecnicaDto>>(Ruta);
        tecnicas = result.Data ?? new List<TecnicaDto>();
        error = result.Success ? null : result.Message;
    }

    private async Task EditarAsync(int id)
    {
        var result = await Api.GetAsync<TecnicaDto>(Ruta, id);
        if (result.Success && result.Data != null)
        {
            tecnica = result.Data;
        }
        else
        {
            error = result.Message;
        }
    }

    private async Task GuardarAsync()
    {
        var mensaje = tecnica.Id == 0 ? "Técnica registrada" : "Técnica actualizada";
        await TerminarAsync(await Api.GuardarAsync(Ruta, tecnica), mensaje);
    }

    private async Task EliminarAsync(int id)
    {
        await TerminarAsync(await Api.DeleteAsync(Ruta, id), "Técnica eliminada");
    }

    private async Task TerminarAsync(ApiResult<bool> result, string mensaje)
    {
        error = result.Success ? null : result.Message;
        exito = result.Success ? mensaje : null;

        if (result.Success)
        {
            Limpiar();
            await CargarAsync();
        }
    }

    private void Limpiar()
    {
        tecnica = new TecnicaDto();
    }
}
