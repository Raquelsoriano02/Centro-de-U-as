@page "/servicios"
@inject ApiService Api

<PageTitle>Servicios</PageTitle>

<h1 class="mb-3">Servicios</h1>

<Alerta @bind-Mensaje="error" />
<Alerta @bind-Mensaje="exito" Tipo="success" />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@(servicio.Id == 0 ? "Nuevo servicio" : "Editar servicio")</h5>
                <EditForm Model="servicio" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-2">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="servicio.Nombre" />
                        <ValidationMessage For="() => servicio.Nombre" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Descripción (opcional)</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="servicio.Descripcion" />
                        <ValidationMessage For="() => servicio.Descripcion" />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label class="form-label">Precio</label>
                            <InputNumber class="form-control" @bind-Value="servicio.Precio" />
                            <ValidationMessage For="() => servicio.Precio" />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label">Duración (min)</label>
                            <InputNumber class="form-control" @bind-Value="servicio.DuracionMinutos" />
                            <ValidationMessage For="() => servicio.DuracionMinutos" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" id="activo" @bind-Value="servicio.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    @if (servicio.Id != 0)
                    {
                        <button type="button" class="btn btn-secondary ms-2" @onclick="Limpiar">Cancelar</button>
                    }
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (servicios == null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (servicios.Count == 0)
        {
            <p>No hay servicios registrados.</p>
        }
        else
        {
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Duración</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in servicios)
                    {
                        <tr>
                            <td>
                                @item.Nombre
                                <div class="small text-muted">@item.Descripcion</div>
                            </td>
                            <td class="text-end">@item.Precio.ToString("N2")</td>
                            <td class="text-end">@item.DuracionMinutos min</td>
                            <td>
                                <span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarAsync(item.Id)">Editar</button>
                                <BotonEliminar OnConfirmar="() => EliminarAsync(item.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private const string Ruta = "api/Servicio";

    private List<ServicioDto>? servicios;
    private ServicioDto servicio = new();
    private string? error;
    private string? exito;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var result = await Api.GetAsync<List<ServicioDto>>(Ruta);
        servicios = result.Data ?? new List<ServicioDto>();
        error = result.Success ? null : result.Message;
    }

    private async Task EditarAsync(int id)
    {
        var result = await Api.GetAsync<ServicioDto>(Ruta, id);
        if (result.Success && result.Data != null)
        {
            servicio = result.Data;
        }
        else
        {
            error = result.Message;
        }
    }

    private async Task GuardarAsync()
    {
        var mensaje = servicio.Id == 0 ? "Servicio registrado" : "Servicio actualizado";
        await TerminarAsync(await Api.GuardarAsync(Ruta, servicio), mensaje);
    }

    private async Task EliminarAsync(int id)
    {
        await TerminarAsync(await Api.DeleteAsync(Ruta, id), "Servicio eliminado");
    }

    private async Task TerminarAsync(ApiResult<bool> result, string mensaje)
    {
        error = result.Success ? null : result.Message;
        exito = result.Success ? mensaje : null;

        if (result.Success)
        {
            Limpiar();
            await CargarAsync();
        }
    }

    private void Limpiar()
    {
        servicio = new ServicioDto();
    }
}
