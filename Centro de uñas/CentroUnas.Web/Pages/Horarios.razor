@page "/horarios"
@inject ApiService Api

<PageTitle>Horarios</PageTitle>

<h1 class="mb-3">Horarios de las técnicas</h1>

<Alerta @bind-Mensaje="error" />
<Alerta @bind-Mensaje="exito" Tipo="success" />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@(horario.Id == 0 ? "Nuevo horario" : "Editar horario")</h5>
                <EditForm Model="horario" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-2">
                        <label class="form-label">Técnica</label>
                        <InputSelect class="form-select" @bind-Value="horario.TecnicaId">
                            <option value="0">Selecciona...</option>
                            @foreach (var item in tecnicas)
                            {
                                <option value="@item.Id">@item.ObtenerNombreCompleto()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => horario.TecnicaId" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Día</label>
                        <InputSelect class="form-select" @bind-Value="horario.DiaSemana">
                            @foreach (var dia in Enum.GetValues<DiaSemana>())
                            {
                                <option value="@dia">@dia</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label class="form-label">Desde</label>
                            <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="horario.HoraInicio" />
                        </div>
                        <div class="col-6 mb-2">
                            <label class="form-label">Hasta</label>
                            <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="horario.HoraFin" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" id="disponible" @bind-Value="horario.Disponible" />
                        <label class="form-check-label" for="disponible">Disponible</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    @if (horario.Id != 0)
                    {
                        <button type="button" class="btn btn-secondary ms-2" @onclick="Limpiar">Cancelar</button>
                    }
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (horarios == null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (horarios.Count == 0)
        {
            <p>No hay horarios registrados.</p>
        }
        else
        {
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Técnica</th>
                        <th>Día</th>
                        <th>Horario</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in horarios.OrderBy(h => h.TecnicaId).ThenBy(h => h.DiaSemana).ThenBy(h => h.HoraInicio))
                    {
                        <tr>
                            <td>@NombreTecnica(item.TecnicaId)</td>
                            <td>@item.DiaSemana</td>
                            <td>@item.HoraInicio.ToString("HH:mm") - @item.HoraFin.ToString("HH:mm")</td>
                            <td>
                                <span class="badge @(item.Disponible ? "text-bg-success" : "text-bg-secondary")">@(item.Disponible ? "Disponible" : "No disponible")</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarAsync(item.Id)">Editar</button>
                                <BotonEliminar OnConfirmar="() => EliminarAsync(item.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private const string Ruta = "api/Horario";

    private List<HorarioDto>? horarios;
    private List<TecnicaDto> tecnicas = new();
    private HorarioDto horario = new();
    private string? error;
    private string? exito;

    protected override async Task OnInitializedAsync()
    {
        tecnicas = await Api.GetListAsync<TecnicaDto>("api/Tecnica");
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var result = await Api.GetAsync<List<HorarioDto>>(Ruta);
        horarios = result.Data ?? new List<HorarioDto>();
        error = result.Success ? null : result.Message;
    }

    private string NombreTecnica(int id)
    {
        return tecnicas.FirstOrDefault(t => t.Id == id)?.ObtenerNombreCompleto() ?? $"#{id}";
    }

    private async Task EditarAsync(int id)
    {
        var result = await Api.GetAsync<HorarioDto>(Ruta, id);
        if (result.Success && result.Data != null)
        {
            horario = result.Data;
        }
        else
        {
            error = result.Message;
        }
    }

    private async Task GuardarAsync()
    {
        var mensaje = horario.Id == 0 ? "Horario registrado" : "Horario actualizado";
        await TerminarAsync(await Api.GuardarAsync(Ruta, horario), mensaje);
    }

    private async Task EliminarAsync(int id)
    {
        await TerminarAsync(await Api.DeleteAsync(Ruta, id), "Horario eliminado");
    }

    private async Task TerminarAsync(ApiResult<bool> result, string mensaje)
    {
        error = result.Success ? null : result.Message;
        exito = result.Success ? mensaje : null;

        if (result.Success)
        {
            Limpiar();
            await CargarAsync();
        }
    }

    private void Limpiar()
    {
        horario = new HorarioDto();
    }
}
