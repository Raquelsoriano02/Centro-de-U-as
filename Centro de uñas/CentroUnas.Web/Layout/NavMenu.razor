<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Centro de Uñas</a>
        <button title="Menú" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="turnos">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Turnos
            </NavLink>
        </div>
        @foreach (var opcion in opciones)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@opcion.Ruta">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @opcion.Titulo
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private readonly (string Ruta, string Titulo)[] opciones =
    {
        ("pagos", "Pagos"),
        ("clientes", "Clientes"),
        ("tecnicas", "Técnicas"),
        ("horarios", "Horarios"),
        ("servicios", "Servicios"),
        ("empleados", "Empleados")
    };

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
