@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="alert alert-@Tipo alert-dismissible" role="alert">
        @Mensaje
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarAsync"></button>
    </div>
}

@code {
    [Parameter]
    public string? Mensaje { get; set; }

    [Parameter]
    public EventCallback<string?> MensajeChanged { get; set; }

    [Parameter]
    public string Tipo { get; set; } = "danger";

    private async Task CerrarAsync()
    {
        await MensajeChanged.InvokeAsync(null);
    }
}
