@if (confirmando)
{
    <span class="text-nowrap">
        <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmarAsync">Sí, eliminar</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmando = false">No</button>
    </span>
}
else
{
    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmando = true">Eliminar</button>
}

@code {
    private bool confirmando;

    [Parameter]
    public EventCallback OnConfirmar { get; set; }

    private async Task ConfirmarAsync()
    {
        confirmando = false;
        await OnConfirmar.InvokeAsync();
    }
}
